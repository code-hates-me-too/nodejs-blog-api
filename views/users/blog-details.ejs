<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-4">

        <div class="starry-blog-detail">

            <div class="row align-items-center">

                <div class="col-md-5">
                    <div class="starry-blog-image">
                        <img 
                            src="/static/images/<%= blog.resim %>" 
                            class="img-fluid" 
                            alt="<%= blog.baslik %>"
                        >
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="starry-blog-header">

                        <h1>
                            <%= blog.baslik %>
                        </h1>

                        <p class="starry-blog-subtitle">
                            <%= blog.altbaslik %>
                        </p>

                    </div>
                </div>

            </div>

            <div class="starry-blog-divider"></div>

            <div class="starry-blog-content">
                <%- blog.aciklama %>
            </div>

        </div>

    </div>

</body>
</html>