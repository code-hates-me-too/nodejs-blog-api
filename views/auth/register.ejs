<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="starry-form-card">

                    <h2 class="starry-form-title">Hesap Bilgileri</h2>

                    <% if (message != undefined) { %>
                        <div class="alert alert-<%= message.class %>">
                            <%= message.text %>
                        </div>
                    <% } %>

                    <form method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="mb-3">
                            <label for="name" class="form-label">
                                Name
                            </label>

                            <input
                                type="text"
                                class="form-control starry-input"
                                id="name"
                                name="name"
                                value="<%= (typeof values !== "undefined") ? values.fullname : "" %>"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                Email
                            </label>

                            <input
                                type="email"
                                class="form-control starry-input"
                                id="email"
                                name="email"
                                value="<%= (typeof values !== "undefined") ? values.email : "" %>"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                Password
                            </label>

                            <input
                                type="password"
                                class="form-control starry-input"
                                id="password"
                                name="password"
                                value=""
                            >
                        </div>

                        <div class="starry-form-actions">
                            <button type="submit" class="btn starry-primary-btn">
                                Kaydet
                            </button>
                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>

</body>
</html>