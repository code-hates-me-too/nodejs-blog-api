<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

        <div class="container mt-3">
            <form method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="row">
                    <div class="col-md-12">
                    <% if (message != undefined) { %>
                        <div class="alert alert-<%= message.class %>">
                            <%= message.text %>
                        </div>
                    <% } %>
                        <div class="row mb-3">
                            <label for="baslik" class="col-sm-2 col-form-label">Name</label>
                            <div class="col-sm-12">
                                <input type="text" class="form-control" id="name" name="name" value="<%= (typeof values !== "undefined") ? values.fullname : "" %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="baslik" class="col-sm-2 col-form-label">Email</label>
                            <div class="col-sm-12">
                                <input type="email" class="form-control" id="email" name="email" value="<%= (typeof values !== "undefined") ? values.email : "" %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="baslik" class="col-sm-2 col-form-label">Password</label>
                            <div class="col-sm-12">
                                <input type="password" class="form-control" id="password" name="password" value="<%= (typeof values !== "undefined") ? values.password : "" %>">
                            </div>
                        </div>
                    
                        <div class="row mb-3">
                            <div class="col-sm-12 offset-sm-0">
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
</body>
</html>