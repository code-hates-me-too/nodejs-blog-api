<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

        <div class="container mt-3">
            <form method="post">
                <div class="row">
                    <div class="col-md-12">
