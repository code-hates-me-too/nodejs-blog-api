<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="roleid" value="<%= role.roleid %>">
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label">Başlık</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="rolename" name="rolename" value="<%= role.rolename %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
            <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 75px;">id</th>
                            <th style="width: 150px;">username</th>
                            <th>email</th>
                            <th style="width: 200px;">işlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.userid %></td>
                                <td>
                                    <%= user.fullname %>
                                </td>                                
                                <td>
                                    <%= user.email %>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/admin/users/<%= user.userid %>">Edit</a>

                                    <form style="display: inline-block;" action="/admin/roles/remove" method="post">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="roleid" value="<%= role.roleid %>">
                                        <input type="hidden" name="rolename" value="<%= role.rolename %>">
                                        <input type="hidden" name="userid" value="<%= user.userid %>">
                                        <button type="submit" class="btn btn-sm btn-danger">Kategoriden Çıkar</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
        </div>
    </div>

</body>
</html>