<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">

            <div class="col-md-12 role-edit-page">

                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>

                <% if (isSystemRole) { %>
                    <div class="alert alert-warning">Bu yerleşik bir rol, adı değiştirilemez.</div>
                    <!-- input'u disabled bırak ya da hiç gösterme, ama kullanıcı listesi/kaldırma butonları görünsün -->
                <% } %>

                <!-- Rol düzenleme -->

                <div class="starry-edit-box">

                    <div class="starry-section-title">
                        <h3>Rol Düzenle</h3>
                    </div>

                    <form method="post">

                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <input
                            type="hidden"
                            name="roleid"
                            value="<%= role.roleid %>"
                        >

                        <div class="row mb-3">

                            <label
                                for="rolename"
                                class="col-sm-2 col-form-label edit-label">
                                Rol Adı
                            </label>

                            <div class="col-sm-8">

                                <input
                                    type="text"
                                    class="form-control starry-input"
                                    id="rolename"
                                    name="rolename"
                                    value="<%= (typeof values !== 'undefined') ? values.rolename : role.rolename %>"
                                >

                            </div>

                        </div>

                        <div class="row mb-3">

                            <div class="col-sm-10 offset-sm-2">

                                <button
                                    type="submit"
                                    class="btn starry-button">
                                    Kaydet
                                </button>

                                <a
                                    href="/admin/roles"
                                    class="btn starry-button-cancel">
                                    İptal
                                </a>

                            </div>

                        </div>

                    </form>

                </div>


                <!-- Role bağlı kullanıcılar -->

                <div class="starry-section-title users-title">
                    <h3>Bu Role Sahip Kullanıcılar</h3>
                </div>

                <div class="starry-table-wrapper">

                    <table class="table starry-table">

                        <thead>
                            <tr>
                                <th style="width: 75px;">ID</th>
                                <th style="width: 150px;">Kullanıcı</th>
                                <th>Email</th>
                                <th style="width: 220px;">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% users.forEach(user => { %>

                                <tr>

                                    <td>
                                        <span class="role-id">
                                            <%= user.userid %>
                                        </span>
                                    </td>

                                    <td>
                                        <strong class="role-name">
                                            <%= user.fullname %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= user.email %>
                                    </td>

                                    <td>

                                        <a
                                            class="btn btn-sm starry-button"
                                            href="/admin/users/<%= user.userid %>">
                                            Edit
                                        </a>

                                        <form
                                            style="display: inline-block;"
                                            action="/admin/roles/remove"
                                            method="post">

                                            <input
                                                type="hidden"
                                                name="_csrf"
                                                value="<%= csrfToken %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="roleid"
                                                value="<%= role.roleid %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="rolename"
                                                value="<%= role.rolename %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="userid"
                                                value="<%= user.userid %>"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm delete-confirm">
                                                Kategoriden Çıkar
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    </div>

</body>
</html>