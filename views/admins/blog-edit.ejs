<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <form method="post" enctype="multipart/form-data" action="/admin/blogs/<%= blog.blogid %>?_csrf=<%= csrfToken %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="row">
                <div class="col-md-10 blog-edit-form">
                    <% if (message != undefined) { %>
                        <div class="alert alert-<%= message.class %>">
                            <%= message.text %>
                        </div>
                    <% } %>
                        <input type="hidden" name="blogid" value="<%= blog.blogid %>">
                        <input type="hidden" name="eskiResim" value="<%= blog.resim %>">
                        <div class="row mb-3">
                            <label for="baslik" class="col-sm-1 col-form-label edit-label">Başlık</label>
                            <div class="col-sm-11">
                                <input type="text" class="form-control starry-input" id="baslik" name="baslik" value="<%= (typeof values !== "undefined") ? values.baslik : blog.baslik %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="altbaslik" class="col-sm-1 col-form-label edit-label">Alt Başlık</label>
                            <div class="col-sm-11">
                                <input type="text" class="form-control starry-input" id="altbaslik" name="altbaslik" value="<%= (typeof values !== "undefined") ? values.altbaslik : blog.altbaslik %>">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="aciklama" class="col-sm-1 col-form-label edit-label">Açıklama</label>
                            <div class="col-sm-11">
                                <textarea id="editor" class="form-control starry-input" name="aciklama"><%- (typeof values !== "undefined") ? values.aciklama : blog.aciklama %></textarea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label for="resim" class="col-sm-1 col-form-label edit-label">Resim</label>

                            <div class="col-sm-11">

                                <img
                                    id="resimPreview"
                                    src="/static/images/<%= blog.resim %>"
                                    class="img-fluid edit-image-preview"
                                    style="max-width:250px;"
                                    alt=""
                                >

                                <p></p>

                                <% if (blog.resim) { %>
                                    <div class="form-check mb-2">
                                        <input
                                            class="form-check-input starry-input"
                                            type="checkbox"
                                            id="resimKaldir"
                                            name="resimKaldir"
                                        >
                                        <label class="form-check-label edit-label" for="resimKaldir">
                                            Resmi Kaldır
                                        </label>
                                    </div>
                                <% } %>

                                <input
                                    type="file"
                                    class="form-control starry-input"
                                    id="resim"
                                    name="resim"
                                    value="<%= (typeof values !== "undefined") ? values.resim : blog.resim %>"
                                >

                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-sm-11 offset-sm-1">
                                <button type="submit" class="btn starry-button">Kaydet</button>
                                <a href="/admin/blogs" class="btn starry-button-cancel">İptal</a>
                            </div>
                        </div>
                    
                </div>
                <div class="col-md-2 blog-edit-options">
                    <p class="edit-section-title">Seçenekler</p><hr>
                    <div class="row mb-1">
                        <div class="col-sm-11 offset-sm-1">     
                            <div class="form-check">
                                <input class="form-check-input starry-input" type="checkbox" id="anasayfa" name="anasayfa" <%= (typeof values !== "undefined") ? (values.anasayfa ? "checked" : "") : (blog.anasayfa ? "checked":"") %>>
                                <label class="form-check-label edit-label" for="anasayfa">
                                    Anasayfa
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-11 offset-sm-1">
                            <div class="form-check">
                                <input class="form-check-input starry-input" type="checkbox" id="onay" name="onay" <%= (typeof values !== "undefined") ? (values.onay ? "checked" : "") : (blog.onay ? "checked":"") %>>
                                <label class="form-check-label edit-label" for="onay">
                                    Onay
                                </label>
                            </div>
                        </div>
                    </div>
                    <br><br><p class="edit-section-title">Kategoriler</p><hr>
                    <div class="row mb-3">
                        <% categories.forEach(category => { %>
                            <div class="col-sm-11 offset-sm-1">
                                <div class="form-check">
                                    <%
                                    const checked =
                                        typeof values !== "undefined"
                                            ? values.categories.includes(String(category.categoryid))
                                            : blog.categories.some(cat => cat.categoryid == category.categoryid);
                                    %>

                                    <input
                                        class="form-check-input starry-input"
                                        type="checkbox"
                                        id="cat<%= category.categoryid %>"
                                        name="categories[]"
                                        value="<%= category.categoryid %>"
                                        <%= checked ? "checked" : "" %>
                                    >
                                    <label class="form-check-label edit-label" for="cat<%= category.categoryid %>">
                                        <%= category.categoryname %>
                                    </label>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </form>
    </div>
    <%- include('../partials/ckeditor') %>
    <script>
        const resimInput = document.getElementById("resim");
        const resimPreview = document.getElementById("resimPreview");

        resimInput.addEventListener("change", function () {
            const file = this.files[0];

            if (!file) {
                return;
            }

            const imageUrl = URL.createObjectURL(file);

            resimPreview.src = imageUrl;
        });
    </script>
</body>
</html>     