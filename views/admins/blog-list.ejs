<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 mt-3">
                <% if (action != "undefined" && action == "delete") { %>
                 <div class="alert alert-success">
                    Blog silindi.
                 </div>
                <% } %>
                <% if (action != "undefined" && action == "create") { %>
                 <div class="alert alert-success">
                    Blog oluşturuldu.
                 </div>
                <% } %>
                <% if (action != "undefined" && action == "edit") { %>
                 <div class="alert alert-success">
                    Blog düzenlendi.
                 </div>
                <% } %>
                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>
                <table class="blog-admin-table">
                    <thead>
                        <tr>
                            <th class="col-id">id</th>
                            <th class="col-image">resim</th>
                            <th>baslik</th>
                            <th>kategori</th>
                            <th class="col-actions">işlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% blogs.forEach(blog => { %>
                            <tr>
                                <td><%= blog.blogid %></td>
                                <td>
                                    <img src="/static/images/<%= blog.resim %>" class="admin-blog-image" alt="">
                                </td>                                
                                <td>
                                    <h5 class="admin-blog-title"><%= blog.baslik %></h5>
                                    <div class="admin-blog-subtitle">
                                        <%= blog.altbaslik %>
                                    </div>
                                </td>
                                <td>
                                <% blog.categories.forEach(category => { %>
                                    <span class="admin-category">
                                        <%= category.categoryname %>
                                    </span>
                                <% }) %>
                                </td>
                                <td>
                                    <a class="admin-btn admin-btn-edit" href="/admin/blogs/<%= blog.url %>">Edit</a>
                                    <a class="admin-btn admin-btn-delete" href="/admin/blog/delete/<%= blog.url %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>