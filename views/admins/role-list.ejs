<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt3">
        <div class="row">
            <div class="col-md-12 mt-3">
                
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 75px;">id</th>
                            <th style="width: 150px;">rolename</th>
                            <th>kullanıcı sayısı</th>
                            <th style="width: 150px;">işlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% roles.forEach(role => { %>
                            <tr>
                                <td><%= role.roleid %></td>
                                <td>
                                    <%= role.rolename %>
                                </td>                                
                                <td>
                                    <%= role.user_count %>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/admin/roles/<%= role.roleid %>">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/admin/roles/delete/<%= role.roleid %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
                <hr>
                <div class="card mt-3">
                    <div class="card-header">
                        Yeni Rol Ekle
                    </div>
                    <div class="card-body">
                        <form action="/admin/roles/create" method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                            <div class="row align-items-center">
                                <div class="col-md-10">
                                    <input
                                        type="text"
                                        class="form-control"
                                        name="rolename"
                                        placeholder="Rol adı"
                                        required
                                    >
                                </div>

                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-success w-100">
                                        Rol Ekle
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                
            </div>
        </div>
    </div>

</body>
</html>