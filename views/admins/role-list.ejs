<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt3">
        <div class="row">
            <div class="col-md-12 mt-3">
                
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 75px;">id</th>
                            <th style="width: 150px;">rolename</th>
                            <th>kullanıcı sayısı</th>
                            <th style="width: 150px;">işlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% roles.forEach(role => { %>
                            <tr>
                                <td><%= role.roleid %></td>
                                <td>
                                    <%= role.rolename %>
                                </td>                                
                                <td>
                                    <%= role.user_count %>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/admin/roles/<%= role.rolename %>">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/admin/roles/delete/<%= role.rolename %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>