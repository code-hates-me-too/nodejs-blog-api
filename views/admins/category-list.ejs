<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 mt-3">
                <% if (action != "undefined" && action == "delete") { %>
                 <div class="alert alert-success">
                    Kategori silindi.
                 </div>
                <% } %>
                <% if (action != "undefined" && action == "create") { %>
                 <div class="alert alert-success">
                    Kategori oluşturuldu.
                 </div>
                <% } %>
                <% if (action != "undefined" && action == "edit") { %>
                 <div class="alert alert-success">
                    Kategori düzenlendi.
                 </div>
                <% } %>
                <% if (categoriesCount == 0) { %>
                    <div class="alert alert-danger">
                        Herhangi bir kategori bulunamadı
                    </div>
                <% } %>
                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>
                <h3 class="admin-page-title">KATEGORİLER</h3>
                <table class="blog-admin-table category-admin-table">
                    <thead>
                        <tr>
                            <th class="col-id">ID</th>
                            <th>İsim</th>
                            <th class="col-actions">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(category => { %>
                            <tr>
                                <td><%= category.categoryid %></td>                                
                                <td><%= category.categoryname %></td>
                                <td>
                                    <a class="admin-btn admin-btn-edit" href="/admin/categories/<%= category.url %>">Edit</a>
                                    <a class="admin-btn admin-btn-delete" href="/admin/categories/delete/<%= category.url %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>