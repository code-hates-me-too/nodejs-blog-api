<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 category-edit-page">
                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>
                <form method="post">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label edit-label">Başlık</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control starry-input" id="baslik" name="baslik" value="<%= (typeof values !== "undefined") ? values.baslik : "" %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn starry-button">Kaydet</button>
                            <a href="/admin/categories/create" class="btn starry-button-cancel">İptal</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>