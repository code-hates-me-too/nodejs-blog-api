<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 category-edit-page">
                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>
                <form method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="categoryid" value="<%= (category.categoryid) ? category.categoryid : values.categoryid %>">
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label edit-label">Başlık</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control starry-input" id="baslik" name="baslik" value="<%= (category.categoryname) ? category.categoryname : values.baslik  %>" >
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn starry-button">Kaydet</button>
                            <a href="/admin/categories" class="btn starry-button-cancel">İptal</a>
                        </div>
                    </div>
                </form>
            </div>
            <p class="category-blog-count">Toplam Blog Sayısı = <%= blogCount %></p>
            <table class="blog-admin-table category-blogs-table">
                    <thead>
                        <tr>
                            <th class="col-id">id</th>
                            <th class="col-image">resim</th>
                            <th>baslik</th>
                            <th class="col-actions">işlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% blogs.forEach(blog => { %>
                            <tr>
                                <td><%= blog.blogid %></td>
                                <td>
                                    <img src="/static/images/<%= blog.resim %>" class="admin-blog-image" alt="">
                                </td>                                
                                <td>
                                    <h5 class="admin-blog-title"><%= blog.baslik %></h5>
                                    <div class="admin-blog-subtitle">
                                        <%= blog.altbaslik %>
                                    </div>
                                </td>
                                <td>
                                    <a class="admin-btn admin-btn-edit" href="/admin/blogs/<%= blog.url %>">Edit</a>

                                    <form style="display: inline-block;" action="/admin/categories/remove" method="post">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="blogid" value="<%= blog.blogid %>">
                                        <input type="hidden" name="categoryid" value="<%= category.categoryid %>">
                                        <input type="hidden" name="categoryurl" value="<%= category.url %>">
                                        <button type="submit" class="admin-btn admin-btn-delete">Kategoriden Çıkar</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
        </div>
    </div>

</body>
</html>