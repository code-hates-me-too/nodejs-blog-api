<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12">
                <form method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="userid" value="<%= user.userid %>">
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label">Kullanıcı Adı</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="fullname" name="fullname" value="<%= user.fullname %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label">Email</label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="email" name="email" value="<%= user.email %>">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="baslik" class="col-sm-2 col-form-label">Roller</label>
                        <div class="col-sm-8">
                            <% roles.forEach(role => { %>
                             <div class="form-check">
                                <input 
                                id="role_<%= role.roleid %>" 
                                type="checkbox" 
                                class="form-chechk-input"
                                name="roles[]"
                                value="<%= role.roleid %>" <%= user.roles.some(rol => rol.roleid == role.roleid) ? "checked" : "" %>
                                >
                                <label for="role_<%= role.roleid %>"><%= role.rolename %></label>
                             </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>