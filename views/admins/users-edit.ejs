<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 user-edit-page">

                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>

                <div class="starry-edit-box">

                    <div class="starry-section-title">
                        <h3>Kullanıcı Düzenle</h3>
                    </div>

                    <form method="post">

                        <input
                            type="hidden"
                            name="_csrf"
                            value="<%= csrfToken %>"
                        >

                        <input
                            type="hidden"
                            name="userid"
                            value="<%= user.userid %>"
                        >

                        <div class="row mb-3">

                            <label
                                for="fullname"
                                class="col-sm-2 col-form-label edit-label">
                                Kullanıcı Adı
                            </label>

                            <div class="col-sm-8">

                                <input
                                    type="text"
                                    class="form-control starry-input"
                                    id="fullname"
                                    name="fullname"
                                    value="<%= user.fullname %>"
                                >

                            </div>

                        </div>

                        <div class="row mb-3">

                            <label
                                for="email"
                                class="col-sm-2 col-form-label edit-label">
                                Email
                            </label>

                            <div class="col-sm-8">

                                <input
                                    type="text"
                                    class="form-control starry-input"
                                    id="email"
                                    name="email"
                                    value="<%= user.email %>"
                                >

                            </div>

                        </div>

                        <div class="row mb-3">

                            <label
                                class="col-sm-2 col-form-label edit-label">
                                Roller
                            </label>

                            <div class="col-sm-8">

                                <div class="role-checkboxes">

                                    <% roles.forEach(role => { %>

                                        <div class="starry-check">

                                            <input
                                                id="role_<%= role.roleid %>"
                                                type="checkbox"
                                                class="form-check-input"
                                                name="roles[]"
                                                value="<%= role.roleid %>"
                                                <%= user.roles.some(rol => rol.roleid == role.roleid) ? "checked" : "" %>
                                            >

                                            <label
                                                for="role_<%= role.roleid %>">
                                                <%= role.rolename %>
                                            </label>

                                        </div>

                                    <% }) %>

                                </div>

                            </div>

                        </div>

                        <div class="row mb-3">

                            <div class="col-sm-10 offset-sm-2">

                                <button
                                    type="submit"
                                    class="btn starry-button">
                                    Kaydet
                                </button>

                                <a
                                    href="/admin/users"
                                    class="btn starry-button-cancel">
                                    İptal
                                </a>

                            </div>

                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>

</body>
</html>