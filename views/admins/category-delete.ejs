<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 category-delete-page">
                <% if (category.blogs.length > 0) { %>
                    <div class="delete-warning category-warning">
                        <p>Bu kategoriye ait bloglar bulunduğu için silinemez.</p>
                        <a href="/admin/categories"><button class="btn delete-confirm">Geri Dön</button></a>
                    </div>
                <% } else { %>
                    <div class="delete-warning">
                        <p class="mb-3">
                            <b><%= category.categoryname %></b> <br> isimli kategoriyi silmek istiyor musunuz?
                        </p>
                        <form method="post">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="categoryid" value="<%= category.categoryid %>">
                            <button class="btn delete-confirm" type="submit">Evet</button>
                            <a href="/admin/categories" class="btn delete-cancel">Hayır</a>
                        </form>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

</body>
</html>