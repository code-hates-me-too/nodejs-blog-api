<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt-3">
        <div class="row">
            <div class="col-md-12 users-page">

                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>

                <div class="starry-section-title">
                    <h3>KULLANICILAR</h3>
                </div>

                <div class="starry-table-wrapper">
                    <table class="table starry-table">

                        <thead>
                            <tr>
                                <th style="width: 75px;">ID</th>
                                <th>İsim</th>
                                <th>Email</th>
                                <th>Roller</th>
                                <th style="width: 180px;">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% users.forEach(user => { %>
                                <tr>

                                    <td>
                                        <span class="role-id">
                                            <%= user.userid %>
                                        </span>
                                    </td>

                                    <td>
                                        <strong class="role-name">
                                            <%= user.fullname %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= user.email %>
                                    </td>

                                    <td>
                                        <% user.roles.forEach(role => { %>
                                            <span class="user-role">
                                                <%= role.rolename %>
                                            </span>
                                            <br>
                                        <% }) %>
                                    </td>

                                    <td>
                                        <a
                                            class="btn btn-sm starry-button"
                                            href="/admin/users/<%= user.userid %>">
                                            Edit
                                        </a>

                                        <a
                                            class="btn btn-sm delete-confirm"
                                            href="/admin/users/delete/<%= user.userid %>">
                                            Delete
                                        </a>
                                    </td>

                                </tr>
                            <% }) %>
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    </div>

</body>
</html>