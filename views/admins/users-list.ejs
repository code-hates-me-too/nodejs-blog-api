<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
</head>
<body>
    
    <%- include('../partials/nav') %>

    <div class="container mt3">
        <div class="row">
            <div class="col-md-12 mt-3">
                <% if (message != undefined) { %>
                    <div class="alert alert-<%= message.class %>">
                        <%= message.text %>
                    </div>
                <% } %>
                <h3>KULLANICILAR</h3>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 75px;">ID</th>
                            <th>İsim</th>
                            <th>Email</th>
                            <th>Roller</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.userid %></td>                                
                                <td><%= user.fullname %></td>
                                <td><%= user.email %></td>
                                <td>
                                <% user.roles.forEach(role => { %>
                                    <%= role.rolename %> <br>
                                <% }) %>
                                </td>
                                <td>
                                    <a class="btn btn-sm btn-primary" href="/admin/users/<%= user.userid %>">Edit</a>
                                    <a class="btn btn-sm btn-danger" href="/admin/users/delete/<%= user.userid %>">Delete</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>