<a href="/blogs" class="list-group-item list-group-item-action active">Tüm Kategoriler</a>
<% categories.forEach(category=> { %>
    <a href="/blogs/category/<%= category.url %>" 
        class="list-group-item list-group-item-action
        <%= selectedCategory == category.url ? "active" : "" %>">
        <%= category.categoryname %>
    </a>
<% }) %>