<div class="category-menu">

    <div class="category-title-first ">
        Kategoriler
    </div>

    <a href="/blogs"
       class="category-link <%= selectedCategory == undefined ? "selected" : "" %>">
        Tüm Kategoriler
    </a>

    <% categories.forEach(category => { %>

        <a href="/blogs/category/<%= category.url %>"
           class="category-link <%= selectedCategory == category.url ? "selected" : "" %>">
            <%= category.categoryname %>
        </a>

    <% }) %>

</div>